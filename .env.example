# Kopieer naar .env
OP_URL=http://openproject:80
OP_API_KEY=            # OpenProject: Mijn account > Toegangstokens > API
GITEA_URL=http://gitea:3000
GITEA_TOKEN=           # Gitea: Instellingen > Toepassingen
WEBHOOK_SECRET=change-me
# Statusnamen in jouw OpenProject-inrichting
STATUS_CLOSED=Gesloten
STATUS_IN_PROGRESS=In behandeling
OP_SECRET_KEY_BASE=   # genereer met: openssl rand -hex 64
OP_HOST_HEADER=localhost:8080   # gelijk aan OPENPROJECT_HOST__NAME
