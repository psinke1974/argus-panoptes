# Copy to .env
OP_URL=http://openproject:80
OP_HOST_HEADER=localhost:8080   # must equal OPENPROJECT_HOST__NAME
OP_SECRET_KEY_BASE=             # generate with: openssl rand -hex 64
OP_API_KEY=                     # OpenProject: My account > Access tokens > API
GITEA_URL=http://gitea:3000
GITEA_TOKEN=                    # Gitea: Settings > Applications
WEBHOOK_SECRET=change-me
# Status names in your OpenProject setup (English install; a Dutch install uses Gesloten / In behandeling)
STATUS_CLOSED=Closed
STATUS_IN_PROGRESS=In progress
